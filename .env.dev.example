# Dev/local environment — copy to .env.dev and run with:
#   BOT_ENV_FILE=.env.dev python -m src.main      (PowerShell: $env:BOT_ENV_FILE=".env.dev")
#
# Purpose: develop and run scripts locally WITHOUT sending to the production
# Telegram. Tests are muted unconditionally by tests/conftest.py; this file
# protects manual/script runs.

# Hard kill-switch for outbound Telegram (preferred — keeps the real token out).
NOTIFICATIONS_ENABLED=false

# If you do need a notifier locally, point it at a PRIVATE test bot + your own
# test chat id — never the prod bot token or the prod admin ids.
TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_ID=

# Use a separate dev database so local runs never mutate the prod ledger.
DATABASE_URL=sqlite:///./data/polymarket.dev.db

# Keep live trading off in dev.
TRADING_MODE=paper

# Don't auto-apply the on-chain import against prod state from a dev run.
ONCHAIN_IMPORT_DRY_RUN=true
