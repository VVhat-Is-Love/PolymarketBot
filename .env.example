# === ЭТАП 1: АКТИВНО ===
# Weather API (OpenWeatherMap)
OPENWEATHER_API_KEY=your_key_here

# Database
DATABASE_URL=sqlite:///./data/polymarket.db

# Logging
LOG_LEVEL=INFO
LOG_PATH=./logs/bot.log

# === ЭТАП 2: АКТИВНО ===
# Strategy (paper trading)
STRATEGY_MIN_VOLUME_USD=5000
STRATEGY_MIN_EDGE_PERCENT=10
STRATEGY_MAX_BASKET_SUM=0.96
STRATEGY_MIN_MODEL_AGREEMENT=3
STRATEGY_MAX_MODEL_DISAGREEMENT_C=1
STRATEGY_BASKET_NEIGHBORS=1
STRATEGY_BASKET_INCLUDE_UPSIDE=true
STRATEGY_VIRTUAL_STAKE_USD=10
STRATEGY_TIME_HORIZON_HOURS=24

# === ЭТАП 3+: ЗАГЛУШКИ (не использовать сейчас!) ===
# Polymarket (понадобится с Этапа 3 — живая торговля)
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
POLYMARKET_HOST=https://clob.polymarket.com

# Blockchain (Этап 3)
POLYGON_RPC_URL=
PRIVATE_KEY=
PROXY_WALLET_ADDRESS=

# AI (Этап 4)
ANTHROPIC_API_KEY=

# Telegram (Этап 5)
TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_ID=

# Risk Management (Этап 3)
DAILY_LOSS_LIMIT_USD=500
MAX_SINGLE_BET_USD=200
STOP_LOSS_PERCENT=15
FAN_LEVELS=5
FAN_STEP_PERCENT=2

# Copy Trading (Этап 6)
COPY_MIN_TRADE_USD=50
COPY_MIN_ROI_PERCENT=20
COPY_DELAY_SECONDS=60

# Cache (Этап 5 — переезд с in-memory на Redis)
REDIS_URL=
